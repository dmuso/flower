{
  "name": "flower-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot public/index.html --spa --port ${FRONTEND_PORT}",
    "build": "bun run scripts/build.ts",
    "serve": "bun run scripts/serve.ts",
    "check": "tsc --noEmit",
    "lint": "bunx oxlint --config oxlint.json src scripts",
    "test": "bun test --preload ./test-setup.ts --timeout 5000 src scripts",
    "tailwind:build": "bunx tailwindcss -i ./src/styles/app.css -o ./src/styles/tailwind.css",
    "tailwind:watch": "bunx tailwindcss -i ./src/styles/app.css -o ./src/styles/tailwind.css --watch"
  },
  "dependencies": {
    "@solidjs/router": "^0.14.5",
    "clsx": "^2.1.1",
    "lucide-solid": "^0.554.0",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.28.5",
    "@dschz/bun-plugin-solid": "^1.0.4",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/cli": "^4.1.17",
    "@types/node": "^22.7.4",
    "babel-preset-solid": "^1.9.3",
    "bun-types": "^1.0.11",
    "happy-dom": "^15.7.1",
    "oxlint": "1.30.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  }
}
