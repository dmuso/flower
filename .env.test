# Flower Application Environment Variables
# Used by `make test` and API unit tests that need a database.

# Application Environment
ENVIRONMENT=test
VERSION=test

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5437
DB_USER=flower_test
DB_PASSWORD=flower
DB_NAME=flower_test
DB_SSL_MODE=disable

# API Configuration
API_PORT=8181
GIN_MODE=release

# Frontend Configuration
FRONTEND_PORT=4273
FRONTEND_API_URL=http://localhost:8180

FRONTEND_ORIGIN=http://localhost:4273
