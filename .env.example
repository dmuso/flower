# Flower Application Environment Variables
# Copy this file to .env and update the values for your environment.
# Treat this file as the source of truth for required variables.
#
# Host ports are owned by Flower and must not overlap Prophet
# (8080 API, 4173 frontend, 5432 Postgres, 5436 test Postgres).

# Application Environment
ENVIRONMENT=development
VERSION=dev

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=flower_dev
DB_PASSWORD=flower
DB_NAME=flower_dev
DB_SSL_MODE=disable

# API Configuration
API_PORT=8180
GIN_MODE=debug

# Frontend Configuration
FRONTEND_PORT=4273
FRONTEND_API_URL=http://localhost:8180
